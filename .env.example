# Copiá este archivo a .env.local y completá los valores.
# .env.local ya está en .gitignore — nunca se sube al repositorio.

# --- Servidor ---
PORT=3001
SITE_URL=http://localhost:5173

# --- Modo de prueba ---
# Con "true", el botón de pago salta Mercado Pago por completo y desbloquea
# el diagnóstico completo directo — para compartir el sitio de prueba sin
# cobrar de verdad. Para volver a pedir el pago real, borrá esta variable
# (no hace falta tocar código).
SKIP_PAYMENT=false

# --- Mercado Pago (Credenciales → Checkout Pro, en tu panel de developers) ---
# La Public Key es segura de compartir (va en el frontend). El Access Token
# es secreto: nunca lo pegues en el chat ni lo subas a ningún repositorio.
# Empezá siempre con las credenciales de PRUEBA hasta probar el flujo entero.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# La URL pública que Mercado Pago va a llamar para avisar de cada pago.
# En local no la recibís (tu compu no es accesible desde internet) — hace
# falta un túnel (ver server/README.md) o probarlo ya desplegado en el VPS.
MP_WEBHOOK_URL=

# --- IA (síntesis del diagnóstico completo) ---
# Clave de Google AI Studio (aistudio.google.com/apikey), free tier. Sin esta
# clave, la síntesis final se arma igual con un texto de respaldo local — no
# es indispensable para que el diagnóstico completo funcione.
GEMINI_API_KEY=

# --- Mail (para mandar el informe) ---
# Casilla propia del dominio (Hostinger Email): contacto@consultoraprisma.digital
# Servidor de salida: SMTP_HOST=smtp.hostinger.com
# Puerto: 465 (SSL, recomendado) o 587 (STARTTLS) — con 465 el código activa
# la conexión segura automáticamente.
# SMTP_PASS es la contraseña real de esa casilla — va SOLO en .env.local
# (nunca en este archivo, nunca en el repo, nunca pegada en un chat).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@consultoraprisma.digital
SMTP_PASS=
MAIL_FROM="Consultora Prisma <contacto@consultoraprisma.digital>"
AGENDAR_URL=http://localhost:5173/#contacto
# A dónde llega el aviso de "alguien pidió una conversación" (el equipo, no el cliente).
TEAM_EMAIL=contacto@consultoraprisma.digital

# --- Google Sheets (espejo de las respuestas, opcional) ---
# URL de un Google Apps Script publicado como Web App (ver
# google-apps-script/sheets_webhook.gs para el código y los pasos). Si se deja
# vacío, simplemente no se manda nada a ninguna planilla — no rompe nada.
SHEETS_WEBHOOK_URL=
