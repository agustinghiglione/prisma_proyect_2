# Cadena de conexión a Postgres. En DigitalOcean App Platform se puede
# vincular automáticamente desde el componente de base de datos.
DATABASE_URL=postgresql://usuario:password@localhost:5432/prisma_consultora

# Poner en "false" solo para Postgres local sin SSL. Dejar sin definir
# (o en cualquier otro valor) en producción — DigitalOcean lo requiere.
# PGSSL=false

# Contraseña para acceder al panel interno en /admin.
ADMIN_PASSWORD=cambiar-esta-contraseña

# URL del frontend deployado, para permitir CORS.
FRONTEND_URL=http://localhost:5173

# Puerto en el que escucha el servidor (DigitalOcean lo define automáticamente).
PORT=3001
