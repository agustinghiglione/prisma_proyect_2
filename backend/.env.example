# --- Google Sheets ---
# ID de la planilla (está en la URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=

# Nombre de la PESTAÑA (no el nombre del archivo) dentro de la planilla.
# Ojo: el nombre del archivo puede ser "Diagnósticos Prisma" pero la pestaña
# interna suele seguir llamándose "Sheet1" si nunca se renombró — hay que
# fijarse en la solapita de abajo en Google Sheets. Por defecto: "Sheet1"
# GOOGLE_SHEET_TAB=Sheet1

# Desarrollo local: nombre del archivo .json de credenciales dentro de backend/
# (nunca se sube al repo, ver .gitignore).
GOOGLE_SERVICE_ACCOUNT_FILE=prisma-consultora-c9107ae1ec15.json

# Producción (DigitalOcean, etc.): el mismo .json pero codificado en base64,
# como variable de entorno. No definir junto con GOOGLE_SERVICE_ACCOUNT_FILE.
# GOOGLE_SERVICE_ACCOUNT_B64=

# --- General ---
# Origen permitido para CORS: la URL del sitio deployado.
FRONTEND_URL=http://localhost:5173

# Puerto de escucha (DigitalOcean lo define automáticamente).
PORT=3001
